rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) ?
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'Customer';
    }

    function isAdmin() {
      return isAuthenticated() &&
             (('role' in request.auth.token && request.auth.token.role in ['Administrator', 'SuperAdmin']) ||
              ('admin' in request.auth.token && request.auth.token.admin == true) ||
              (request.auth.token.email in ['admin@gmail.com', 'admin@email.com', 'chisomo.banda@iwalecar.mw']) ||
              getUserRole() in ['Administrator', 'SuperAdmin']);
    }

    function isCarWashOwner() {
      return isAuthenticated() && (getUserRole() == 'Car Wash Owner' || request.auth.token.email == 'owner@gmail.com');
    }

    // 1. User Profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin() || isAuthenticated();
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['uid', 'fullName', 'firstName', 'lastName', 'phoneNumber', 'email', 'role', 'requestedRole', 'primaryLocation', 'bio', 'createdAt'])
                    && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'role', 'phoneNumber', 'primaryLocation'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role == 'Customer'
                    && (!('requestedRole' in request.resource.data) || request.resource.data.requestedRole in ['Customer', 'Car Wash Owner'])
                    && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100
                    && (!('firstName' in request.resource.data) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50))
                    && (!('lastName' in request.resource.data) || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 50))
                    && request.resource.data.email is string
                    && request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 20
                    && request.resource.data.primaryLocation is string && request.resource.data.primaryLocation.size() <= 50
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 180))
                    && request.resource.data.createdAt is number;
      allow update: if isOwner(userId)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'firstName', 'lastName', 'phoneNumber', 'primaryLocation', 'bio'])
                    && request.resource.data.fullName is string && request.resource.data.fullName.size() <= 100
                    && (!('firstName' in request.resource.data) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 50))
                    && (!('lastName' in request.resource.data) || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 50))
                    && request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 20
                    && request.resource.data.primaryLocation is string && request.resource.data.primaryLocation.size() <= 50
                    && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 180))
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.createdAt == resource.data.createdAt;
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                    && request.resource.data.role in ['Car Wash Owner', 'Administrator']
                    && (
                      !exists(/databases/$(database)/documents/ownerApplications/$(userId)) ||
                      get(/databases/$(database)/documents/ownerApplications/$(userId)).data.status == 'APPROVED'
                    );
    }

    match /ownerApplications/{applicantUid} {
      allow read: if isOwner(applicantUid) || isAdmin();
      allow create: if isOwner(applicantUid)
                    && request.resource.data.applicantUid == request.auth.uid
                    && request.resource.data.applicantEmail == request.auth.token.email
                    && request.resource.data.status == 'PENDING';
      allow update: if (isOwner(applicantUid)
                        && resource.data.status == 'REJECTED'
                        && request.resource.data.applicantUid == request.auth.uid
                        && request.resource.data.applicantEmail == request.auth.token.email
                        && request.resource.data.status == 'PENDING')
                    || (isAdmin()
                        && resource.data.status == 'PENDING'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewNotes', 'reviewedAt', 'reviewedBy'])
                        && request.resource.data.status in ['APPROVED', 'REJECTED']);
      allow delete: if false;
    }

    // 2. Facilities, Bays & Tiers
    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if isAdmin() || (isCarWashOwner() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAuthenticated()
                    && (resource.data.ownerId == request.auth.uid || isAdmin())
                    && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isAdmin();

      match /bays/{bayId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated()
                      && (get(/databases/$(database)/documents/facilities/$(facilityId)).data.ownerId == request.auth.uid || isAdmin());

        match /tiers/{tierId} {
          allow read: if true;
          allow create, update, delete: if isAuthenticated()
                        && (get(/databases/$(database)/documents/facilities/$(facilityId)).data.ownerId == request.auth.uid || isAdmin());
        }

        match /schedule/{document=**} {
          allow read: if true;
          allow write: if isAuthenticated();
        }
      }
    }

    // 2b. Approved & Rejected Car Wash Facilities Collections
    match /approvedFacilities/{facilityId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isCarWashOwner());
    }

    match /rejectedFacilities/{facilityId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isCarWashOwner());
    }

    // 2c. Dedicated Bays Collection
    match /bays/{bayId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() && (isAdmin() || isCarWashOwner());
    }

    // 2c. Payments & Admin Notifications Collections
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.customerId == request.auth.uid || resource.data.customerEmail == request.auth.token.email || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /adminNotifications/{notificationId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Bookings (Direct Client-Side Operations with Security Checks)
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() &&
                    (resource.data.customerId == request.auth.uid ||
                     resource.data.ownerId == request.auth.uid ||
                     resource.data.customerEmail == request.auth.token.email ||
                     isAdmin());
      allow create: if isAuthenticated() &&
                    request.resource.data.customerId == request.auth.uid &&
                    request.resource.data.bookingStatus in ['PENDING_PAYMENT', 'UPCOMING', 'In Progress'] &&
                    request.resource.data.paymentStatus in ['PENDING', 'SUCCESSFUL'];
      allow update: if isAuthenticated() &&
                    (
                      // Customer payment completion or extension
                      (resource.data.customerId == request.auth.uid &&
                       request.resource.data.amountValue >= resource.data.amountValue) ||
                      // Facility Owner operational status changes
                      (resource.data.ownerId == request.auth.uid || resource.data.ownerId == request.auth.token.email) ||
                      // Administrator management
                      isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // 4. Booking Requests (Idempotency Locks)
    match /bookingRequests/{requestId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && request.resource.data.customerId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // 5. Quarantine Slot Guards & Audit Logs
    match /quarantineSlotGuards/{guardId} {
      allow read, write: if isAdmin();
    }

    match /quarantineAuditLogs/{logId} {
      allow read, write: if isAdmin();
    }
  }
}
