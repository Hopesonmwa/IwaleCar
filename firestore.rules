rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles collection
    match /users/{userId} {
      // Allow user to read their own profile or allow admins to read all profiles
      allow read: if request.auth != null && (request.auth.uid == userId || resource.data.role == 'Administrator' || resource.data.role == 'SuperAdmin');

      // Public registration: allow user to create their document on signup, preventing self-assigned admin roles
      allow create: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['User', 'Car Wash Owner']);

      // Profile updates: allow user to update details but forbid changing their own role to Administrator
      allow update: if request.auth != null && request.auth.uid == userId
                    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
    }

    // Default rule for other collections (facilities, bookings, etc.)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
